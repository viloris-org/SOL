[Daemon]
name = "sol-compositor"
exec = "/usr/bin/sol-compositor"
type = "core"
start_mode = "boot"
restart_policy = "always"

after = []
requires = []

capabilities = [
    "compositor.render",
    "compositor.input",
    "system.drm",
    "system.input_devices"
]

[Environment]
SOL_SCP_SOCKET = "sol-compositor-0"
