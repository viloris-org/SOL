[Daemon]
name = "sol-compositor"
exec = "/usr/bin/sol-compositor"
type = "core"
start_mode = "boot"
restart_policy = "always"

after = []
requires = []

capabilities = [
    "compositor.render",
    "compositor.input",
    "system.drm",
    "system.input_devices"
]

[Environment]
SOL_SCP_SOCKET = "/run/sol/compositor.sock"
# The path is reachable by the authenticated user's processes; SCP still
# admits peers only after sol-logind authorizes their UID.
SOL_SCP_SHARED_SOCKET = "1"
