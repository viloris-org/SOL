# SOL Kernel Configuration for x86_64
# Generated for ISO builds - minimal but complete

# General setup
CONFIG_LOCALVERSION="-sol"
CONFIG_DEFAULT_HOSTNAME="sol"
CONFIG_KERNEL_XZ=y

# Built-in command line (EFI stub boot without a boot-loader-supplied cmdline)
# The initrd= directive tells the EFI stub to load the SOL initramfs from the
# kernel's own volume (the SOL ESP). Forward slashes are converted to EFI
# path separators by the stub (see drivers/firmware/efi/libstub/file.c).
# console=ttyS0 makes the boot log observable through QEMU's serial port.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="quiet loglevel=3 console=ttyS0 console=tty0 initrd=/EFI/SOL/slots/A/initrd.img"

# Enable essential features
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NUMA=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Block layer
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=65536

# Initramfs support (busybox-based SOL initramfs)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# UEFI boot (sol-boot loads the kernel through EFI LoadImage)
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# ISO9660 / UDF (live medium: squashfs lives on the ISO filesystem)
CONFIG_ISO9660_FS=y
CONFIG_ISO9660_EXTATTR=y
CONFIG_ISO9660_FILETYPES=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y

# DRM/KMS for graphics
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMD=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y

# Framebuffer
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# Input devices (keyboard, mouse, touchpad)
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_INPUT_MOUSEDEV=y

# HID support
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_I2C_HID=y

# USB support
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y

# PCI support
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y

# ACPI
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y

# Power management
CONFIG_PM=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_IDLE=y

# Networking (minimal)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# Disable wireless (not needed for Phase 0)
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set

# Sound (ALSA/PipeWire)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y

# Virtualization support (for testing)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_ATI_IXP=y

# TTY/Console
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# Security
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y

# Disable debug symbols to reduce size
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_KERNEL is not set
